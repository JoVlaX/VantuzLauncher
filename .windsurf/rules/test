axioms:
  interpretation:
    determinism_mode: "Assume temperature=0 behavior: prefer single unambiguous interpretations; when multiple valid implementations exist, choose the simplest that satisfies the constraints."
    requirement_keywords:
      MUST: "Hard requirement, but bounded by platform/OS/host constraints. If it cannot be satisfied, the system must fail fast with an explicit, actionable error rather than pretending success."
      MANDATORY: "Strong requirement unless infeasible on the target platform; in that case, apply the closest safe alternative and state the deviation explicitly."
      FORBIDDEN: "Prohibited design/behavior. If a rule conflicts with a MUST in this constitution, treat it as a specification error and prefer the MUST while reporting the conflict."
    measurability:
      rule_quality_gate: "Prefer rules that can be enforced by build-time tooling, tests, or deterministic static validation. Avoid rules that require perfect knowledge of future runtime conditions or physical guarantees."
  architectural_flow:
    execution_flow: "Payload -> Receiver (Command Entry Point) -> Pipeline -> State Mutation -> EDA Event -> EventHandler"
    state_flow_constraint: "STRICT_UNIDIRECTIONAL (Cyclic runtime calls between steps are FORBIDDEN)"

  global_verification_enforcement:
    human_factor_reliance: "FORBIDDEN (Manual review alone is not accepted as the only enforcement mechanism)"
    runtime_only_checks: "FORBIDDEN (Runtime checks may exist, but they must not be the sole enforcement mechanism when static or build-time validation is feasible)"
    mandatory_sdk_tooling:
      - "Incremental source analyzers (e.g., Roslyn analyzers) inside Armatura.Core.Sdk"
      - "Compile-time transformation where appropriate (e.g., source generators, IL weaving, or compiler interceptors)"
      - "Ahead-of-time sanitization/validation of call graphs when applicable"
    compilation_errors_triggers:
      - "Usage of AssemblyLoadContext.LoadFromAssemblyPath when a stream-based loading path is available and required by policy"
      - "Passing raw I/O Stream objects instead of Virtual Descriptors (Data Tokens)"
      - "Failure to honor cancellation semantics inside any Blueprint contract (via an explicit CancellationToken parameter or an approved ambient execution context mechanism)"
      - "Manual boilerplate pipeline step creation bypassing authorized SDK base classes"
      - "Discovery of any IArmaturaContract interface or QuantizedNode implementation containing both Read (Query) and Write (Command) operations simultaneously (Strict CQRS Blending Check)."

  categories:
    1_nomadic_and_code_generation:
      inversion_of_control:
        runtime_di_containers:
          status: "FORBIDDEN inside Core/Engine (Allowed exclusively in UI layer)"
          mandatory_alternative: "Compile-Time Pipeline Weaving via C# Blueprint Interfaces."
        interface_overproliferation:
          status: "FORBIDDEN (Implicit matrix fragmentation of interfaces without physical bounds is banned)"
          mandatory_alternative: "Bounded Blueprint-Contract Coupling."
        global_runtime_dependency_factories:
          status: "FORBIDDEN"
          mandatory_alternative: "Declarative Pipeline Node Factory Registries mapping directly to Blueprint Tokens."
      service_locator:
        status: "FORBIDDEN (Central registries/service stores queryable by modules are banned)"
        mandatory_alternative: "Explicit Input Payloads mapping. Pass all required state as read-only properties of the Command/Query Payload object."
      convention_over_configuration:
        status: "FORBIDDEN (No implicit magic, no auto-pickup of files via naming/paths)"
        mandatory_alternative: "Explicit declaration inside manifest (boot.json)."
      code_generation_protocols:
        blind_source_generation:
          status: "FORBIDDEN (Generating contract types from text configs without a pre-existing manual C# blueprint is banned)"
          mandatory_alternative: "Universal Blueprint Packaging."
        runtime_on_the_fly_compilation: "FORBIDDEN (Dynamic type compilation inside a running host process is a total taboo)"
        compiler_trace_hiding: "FORBIDDEN"
        mandatory_project_setting: "<EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>"
      plugin_security_sandbox:
        runtime_isolation: "MANDATORY (Sandboxed plugin execution, preferably via a lightweight WebAssembly runtime; specific engine choice is implementation-defined)"
        host_protection_mechanisms: "Resource limits (memory, CPU time/quantum) enforced by the Host"
        violation_handling: "Terminate the sandboxed instance on timeout or quota breach and surface a deterministic error"
        invariant_safeguard: "Ahead-of-time sanitization via static analysis of the call graph before loading/execution"

    2_tool_agnosticism_and_composability:
      wrappers_and_adapters:
        status: "FORBIDDEN (Do not create endless imperative translator classes around external tools within business logic)"
        mandatory_alternative: "Pipeline Command Enqueuing via Data-Driven Payloads."
      protocol_based_agnosticism: "FORBIDDEN"
      evolution_safeguards:
        hardcoded_versions: "FORBIDDEN (Banned inside Vantuz Engine code. All versioning metadata must live in the 'Variables' block of the configuration manifest)"
        system_mutations: "Driven exclusively by updating declarative manifests and Payload data structures"

    3_anticorruption_layer_boundaries:
      shared_kernel: "FORBIDDEN (Shared mutable code libraries or cross-process database tables with third-party tools/mods are banned)"
      conformist_pattern:
        status: "FORBIDDEN (Adapting internal domain data models to match chaotic external APIs is banned)"
        mandatory_alternative: "Isolated Anticorruption Ingress Mapper Nodes."
      data_standardization_assumptions: "FORBIDDEN (Explicit defensive ACL protection is MANDATORY)"

    4_srp_cqrs_and_routing:
      logic_blenders:
        status: "FORBIDDEN (Combining Query/Read and Command/Write functions inside one component, method, or contract is banned)"
        mandatory_alternative: "Strict CQRS Separation."
        ai_compiler_enforcement: "The Armatura.Core.Sdk Roslyn Analyzer MUST classify any contract as a Query if its methods return data fields without modifying state, or as a Command if its methods return an execution status token. Detecting signatures of both operational types inside a single contract interface or Node implementation automatically triggers a compilation error ARM005: CQRS_Ambiguity_Blender_Forbidden."
      smart_orchestrators:
        status: "FORBIDDEN (Hardcoding step logic and call execution sequences inside a Command file is banned)"
        mandatory_alternative: "Externalized Declarative Manifests / Macro Pipelines."
      configuration_branching:
        status: "FORBIDDEN (No logical conditional operators like if/else or loops inside JSON/YAML manifests; boot.json must remain non-Turing-complete)"
        mandatory_alternative: "Polymorphic Route Overrides and Condition Payloads."
      routing_architecture:
        cascaded_micro_routers: "FORBIDDEN"
        composite_routing_keys: "FORBIDDEN as raw unstructured text strings"
        ingress_protocol: "MANDATORY Enforced Slot Matching via strongly-typed named slots on host Ingress schemes"
        backwards_compatibility: "MANDATORY"
        collision_handling:
          implicit_runtime_routing: "FORBIDDEN"
          hash_based_path_guessing: "FORBIDDEN"
          alphabetical_shadowing: "FORBIDDEN"
          action_on_symmetry: "Halt scope execution immediately, throw AmbiguousRouteException, and require explicit resolution in the 'Overrides' block of boot.json."
      ai_agent_code_generation:
        status: "FORBIDDEN (Outputting free-form unquantized async code is banned; AI logic cannot define loose async Task methods directly)"
        mandatory_alternative: "Inherit exclusively from Armatura.Core.Sdk.Nodes.QuantizedNode and override ExecuteQuantumAsync(). Free-form async Task methods are compile-time forbidden."

    5_states_threads_and_transactional_isolation:
      shared_mutable_state:
        status: "FORBIDDEN (Direct concurrent mutation or cross-thread sharing of caches/variables is banned)"
        mandatory_alternative: "Immutable 'with' Mutations and Message Passing via EDA Bus."
      ui_thread_interaction:
        synchronous_blocking_calls: "FORBIDDEN (Usage of Dispatcher.Invoke is a total taboo)"
        asynchronous_dispatch: "MANDATORY via Dispatcher.BeginInvoke using Background Priority"
      ui_thread_flooding: "FORBIDDEN (Core Engine is prohibited from bombarding the UI thread with high-frequency progress updates)"
      ui_mitigation_protocol: "Throttling & Batching Layer (e.g., Rx Sample matching screen refresh rates) must reside exclusively on the UI/Shell side"
      hidden_side_effects: "FORBIDDEN (Queries and reading operations must be pure; all side effects must be isolated into distinct pipeline steps)"
      event_publishing_boundaries:
        premature_broadcasting: "FORBIDDEN"
        two_level_contract_classification:
          domain_state_mutations:
            buffer: "Transaction Event Stage (Memory-isolated scope)"
            success_action: "Atomic Flush to EDA bus"
            failure_action: "Immediate, absolute deletion (Drop) upon transaction abort or Sparse Undo Log activation"
          episodic_telemetry_non_domain:
            buffer: "FORBIDDEN to retain in Transaction Event Stage (Prevents RAM Exhaustion / OOM)"
            routing: "Direct bypass channel to EDA bus for UI consumption"
      invariant_evacuation_safety: "During active Emergency Evacuation Mode, the failure_action (Drop / Sparse Undo Log activation) for system commands has the highest memory reservation priority. The Host MUST attempt to reserve the minimum required Sparse Undo Log capacity upfront; if this reservation cannot be satisfied due to physical limits or fragmentation, the Host MUST fail fast into a Fatal Failure state (do not continue with a false guarantee)."
      diagnostic_trail_integrity:
        auditability_black_holes: "FORBIDDEN"
        failure_protocol: "Host must freeze the execution log buffer from CompositeReporter and persist it to a configured diagnostics folder as failed_{CorrelationId}.log (best-effort; if persistence is unavailable, emit an explicit durable fallback such as OS event log or crash report payload)."
      state_destruction: "FORBIDDEN to execute pre-emptive deletion/clearing of target paths without calculating free space and selecting an appropriate Shadow Buffer / Sparse Undo Log regulated by a Ring Buffer"

    6_interfaces_serialization_and_caching:
      leaky_abstractions: "FORBIDDEN (External dependency types must never contaminate domain structures; utilize Contract-First DTO primitives exclusively)"
      temporal_coupling:
        status: "FORBIDDEN (Blocking sync constructs like .Result, .Wait(), Thread.Sleep() are banned inside pipeline logic; do not convert async flows into sync waits)"
        mandatory_alternative: "Use asynchronous composition with deterministic cancellation semantics (explicit token or approved ambient execution context), enforced by SDK contracts."
      heavy_serialization:
        status: "FORBIDDEN (Direct transmission of FileStream, live sockets, or heavy raw byte arrays byte[] inside pipeline payloads is banned)"
        mandatory_alternative: "Virtual Descriptors / Integer Data Tokens."
      resource_management_delegation:
        plugin_side_cleanup: "FORBIDDEN (Plugins must be stateless; tracking Virtual Descriptor lifetimes is the sole responsibility of the Host via DAG Ref Counting and Scoped Lease Tracking)"
        plugin_side_deadlock_sorting: "FORBIDDEN"
        infinite_resource_retention: "FORBIDDEN"
        isolated_quotas: "FORBIDDEN"
      cache_staleness: "FORBIDDEN (Resource Manager must use Write-Through Eviction on write/mutation requests)"
      concurrency_degradation:
        raw_path_locking: "FORBIDDEN"
        operational_root_over_coarsening: "FORBIDDEN"
        concurrency_mitigation: "Normalization must lock the exact localized workspace root returned via GetOperationalRootFolder(TargetPhysicalResource), mapped to 64 independent striping slots"
      host_wasm_boundary_protocols:
        marshaling_by_copy: "FORBIDDEN (Object serialization via JSON/MsgPack across Host and WASM boundary is a critical vulnerability)"
        architectural_requirement: "Prefer zero-copy or bounded-copy binary marshaling across the Host/WASM boundary. The chosen mechanism must be deterministic, bounded in memory, and explicitly versioned."
        payload_reading: "Prefer bulk transfers (single/batched buffers) and in-place readers when feasible. If true zero-copy is infeasible on the target runtime, use a bounded-copy buffer protocol with strict size limits."
        state_return_protocol:
          status: "FORBIDDEN to return unbounded dynamic-size guest domain objects without explicit size limits and allocation policy. Return states must use Host-managed buffers or explicitly bounded streaming pages mapped to CorrelationId."
          mandatory_alternative: "Quantized page-based streaming over fixed-size slots or Host-managed buffers with explicit upper bounds."
          mandatory_alternative_iteration: "Use a declarative paging/router node (e.g., Armatura.Core.Sdk.Nodes.PageStreamingRouter or an equivalent) configured in boot.json."
        host_imports_frequency: "High-frequency per-record native imports are FORBIDDEN. Cross-boundary calls must be batched; allow a small, implementation-defined number of boundary calls per execution quantum."

    7_diagnostics_and_lifecycle_throttling:
      diagnostic_pollution:
        status: "FORBIDDEN (Imperative string formatting, lexical rendering, filtering, or physical file-writing logic must never be embedded inside compute steps/plugins)"
        mandatory_alternative: "Structured Data-Driven Diagnostics via Context Payloads."
      blind_tracing: "FORBIDDEN (Any logging event lacking a bound, ambient CorrelationId is classified as architectural garbage)"
      cancellation_blindness: "FORBIDDEN (Internal data loops, I/O processing, and network operations must actively accept, check, and propagate a deterministic cancellation signal: CancellationToken or an approved ambient execution context mechanism)"
      resource_coma_and_stuttering:
        inline_compression: "FORBIDDEN (Synchronous LZ4 compression of disk assets on the primary CPU thread during I/O interception is banned)"
        compression_mitigation: "Delta tracking must buffer through an isolated Memory-Mapped Ring Buffer with asynchronous packet compression offloaded to the ThreadPool"
        global_backpressure: "FORBIDDEN"
        backpressure_mitigation: "Resource Manager must isolate backpressure strictly within specific segments via Striped Ring Buffer Quotas"
        trigger_mechanisms: "Binary On/Off gates and artificial runtime micro-delays are FORBIDDEN. System must operate strictly on Batching Gates via Continuous Proportional Backoff"
        disk_deficit_mutations: "FORBIDDEN to run in-place operations under low disk space with a file reserve limited by the Concurrency Multiplier scaling"
        emergency_evacuation_vulnerability: "Absence of an Emergency Evacuation Mode at the designated capacity threshold of the total reserve pool is a critical vulnerability"
        emergency_protocol: "Host must hard-block or aggressively shed incoming application traffic from Plugin_Space_Queue while prioritizing internal system infrastructure pipelines to preserve core liveness and recovery actions"
      thread_micromanagement:
        custom_runtime_schedulers: "FORBIDDEN (Heavy custom Dedicated Compute TaskSchedulers are banned)"
        scheduling_mitigation: "Time budget management is completely delegated to the static compilation phase via Compile-Time Pipeline Weaving."
        backpressure_quantum_alignment: "Avoid blocking waits and OS-level sleep primitives inside ExecuteQuantumAsync(). Prefer cooperative yielding and Host-controlled scheduling. If a wait primitive is unavoidable due to platform APIs, it must be bounded, cancellation-aware, and treated as an exception path rather than the normal regulation mechanism."
        asynchronous_dumping: "High-frequency streaming marshaling or loose asynchronous task throwing into Plugin_Space_Queue is FORBIDDEN"
        batching_requirement: "Task Bundler / Quantum Task Batching is MANDATORY. Merges fine-grained sandbox requests into fixed-size Execution Bundles processed within a single indivisible CPU quantum"
      hardware_failure_handling:
        static_timing_rigidity: "FORBIDDEN"
        timing_protocol:
          formula: "MaxLeaseTTL must adjust dynamically via an I/O-Driven Adaptive Lease Ticking loop based on Moving Average I/O Latency."
          lease_average_flush_protocol: "When the Host transitions from fault to normal status or detects a Host Session Migration Event, the engine MUST reset or re-window the Moving Average I/O Latency buffer back toward a defined baseline (`Genesis Latency Benchmark`) so historical spikes do not dominate new lease calculations."
        safety_line_breach: "Triggers Fatal Failure state. Host aborts adaptation, revokes leases, tags descriptors as Poisoned, and breaks the blocked plugin via PoisonLeaseException"
        post_mortem_logging: "Wiping out producer crash context is FORBIDDEN."

    8_configuration_and_crash_boundaries:
      hardcoded_logic_feature_toggles:
        status: "FORBIDDEN (Hardcoding business decisions based on external mod versions, structural paths, server domains, or environment IDs inside C# code is banned)"
        mandatory_alternative: "Declarative Feature Capabilities Mapping via Matrix Slot Providers."
      plugin_lifecycle_hijacking: "FORBIDDEN (Plugins are prohibited from invoking Environment.Exit or killing host OS processes. Faults must fail-fast strictly within the plugin's Crash Boundary)"
      undifferentiated_crashes: "FORBIDDEN (A local infrastructure fault or lease timeout of a single hanging plugin must never propagate or trigger a PoisonLeaseException in healthy parallel consumers sharing a Virtual Descriptor)"
      metadata_bloat: "FORBIDDEN"
      runtime_graph_evaluation: "FORBIDDEN"
      graph_mitigation: "Amortized Declarative Caching via O(1) validation of an immutable, signed manifest.snapshot generated strictly during installation/update is MANDATORY"
      token_blindness: "FORBIDDEN"
      ledger_protection: "Direct un-sanitized write access from sandboxed code into the Shared Causality Ledger segment is FORBIDDEN. Synchronization must execute through an Out-of-Process Isolation Ring over a Lock-Free Thread-Local Ring Buffer"
      causality_throttling: "FORBIDDEN to require synchronous disk or MMF writes from plugins to record causal paths at each runtime step"
      dynamic_semaphore_hijacking: "FORBIDDEN (Plugins cannot perform dynamic, on-the-fly semaphore acquisition mid-run upon discovery of hidden dependencies). Host must shut down the pipeline via SuspendedForLockingPayload, record the Scope Version Vector, release all semaphores, reset to the Genesis Stack, and trigger an Ingress-level re-indexing"

  portable_cryptography_protocol:
    coupling_constraint: "Absolute path mapping and platform-bound crypto (Windows DPAPI) are FORBIDDEN"
    implementation: "Core utilizes Cryptographic Random Salt generated dynamically and written in cleartext within the unencrypted session file header, supporting 'Nomadic' host-agnostic migrations."

mathematical_dependencies:
  mathematical_formulas:
    routing_specificity_calculation:
      formula: "Specificity = \\sum (Exact\\ Named\\ Slot\\ Match = 1) + (Wildcard\\ * = 0)"
      application: "Evaluated during pattern match collisions at host ingress prior to fallback prioritization by integer priority values"

    striped_path_locking_index:
      formula: "SegmentIndex = GetHashCode(ToCanonicalAbsolutePath(GetOperationalRootFolder(TargetPhysicalResource))) \\pmod{StripeCount}"
      application: "Enforces thread safety and sequencing strictly within a specific mod workspace while retaining parallel throughput for distinct ModIDs; StripeCount is a configurable constant (default: 64)"

    livelock_phase_shift_limit:
      formula: "N_{limit} = \\text{Math.Max}(3, \\text{Math.Min}(\\text{MaxParallelPipelines}, 8))"
      application: "Defines maximum allowable sequential cache resets/phase shifts before upgrading a fault from Phase Shift to Fatal Failure and executing a system-wide Fail-Fast."

    sparse_undo_log_pool_allocation:
      formulas:
        - "ConcurrencyMultiplier = Math.Min(MaxParallelPipelines, 4)"
        - "EvacuationFloor = (Host.InEmergencyMode == true) ? 1 : 0"
        - "BucketQuota = (TotalBufferSize / 64) * Math.Max(1, Math.Max(EvacuationFloor, ConcurrencyMultiplier))"
        - "PoolSize = BucketQuota * 64"
      application: "Calculated at core initialization or dynamically adjusted during Emergency Evacuation Mode to protect the Sparse Undo Log from zero-pool allocation faults under any combination of MaxParallelPipelines and Evacuation Mode states."

  continuous_proportional_backoff_thresholds:
    low_water_mark:
      percentage: 50
      action: "Switch Ingress Gates to bundle aggregation mode. High-frequency asynchronous EDA tasks are merged into large Execution Bundles to reduce Context Switching Overhead"
    high_water_mark_backpressure:
      percentage: 75
      action: "Forcibly inject a Micro-Quantum Yield interceptor via the ambient context parameter inside active writing nodes. The Host DAG scheduler MUST intercept the next sequential context.YieldQuantumAsync() or context.StepAsync() call, converting it into an un-allocating infrastructure pause. This throttles the execution of the writing plugin to target reserving a minimum slice of 25% CPU capacity for Plugin_Space_Queue and active WASM runtime execution loops; if the target cannot be sustained, the Host must shed load or escalate to Emergency Evacuation Mode rather than assuming the guarantee holds."
    emergency_evacuation_threshold:
      percentage: 90
      target: "Total capacity of the general reserve pool"
      action: "Enforce Emergency Evacuation Mode: Hard-block the application-level Plugin_Space_Queue while maintaining clear execution paths for System_Infrastructure_Queue and Core.TransactionAborted commands"
