<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Vantuz.Products.MinecraftLauncher.GUI.Avalonia.ViewModels"
        x:Class="Vantuz.Products.MinecraftLauncher.GUI.Avalonia.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Vantuz Minecraft Launcher"
        Width="900"
        Height="600"
        Background="#1a1a2e">
    
    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>
    
    <Window.Styles>
        <StyleInclude Source="avares://Vantuz.Products.MinecraftLauncher.GUI.Avalonia/Styles/MinecraftLauncherTheme.axaml" />
    </Window.Styles>
    
    <Panel>
        <Grid Margin="40" RowDefinitions="Auto,*,Auto">
            <StackPanel Grid.Row="0" Spacing="10">
                <TextBlock Text="VANTUZ" 
                          Classes="H1"
                          HorizontalAlignment="Center" />
                <TextBlock Text="Minecraft Launcher"
                          Classes="Subtitle"
                          HorizontalAlignment="Center" />
            </StackPanel>
            
            <Border Grid.Row="1" 
                   Classes="Card"
                   MaxWidth="400"
                   VerticalAlignment="Center">
                <StackPanel Spacing="20">
                    <TextBlock Text="Вход в систему" Classes="H2" />
                    
                    <TextBox Watermark="Имя пользователя"
                            Text="{Binding Username}"
                            Classes="mc-input" />
                    
                    <TextBox Watermark="Пароль"
                            Text="{Binding Password}"
                            PasswordChar="●"
                            Classes="mc-input" />
                    
                    <Button Content="ЗАПУСТИТЬ MINECRAFT"
                           Command="{Binding LoginCommand}"
                           Classes="mc-button primary"
                           HorizontalAlignment="Stretch" />
                </StackPanel>
            </Border>
            
            <StackPanel Grid.Row="2" Spacing="10">
                <TextBlock Text="{Binding CurrentStatus}" 
                          Classes="StatusText" />
                <ProgressBar Value="{Binding OverallProgress}" 
                            Maximum="100"
                            Classes="mc-progress" />
            </StackPanel>
        </Grid>
    </Panel>
</Window>
