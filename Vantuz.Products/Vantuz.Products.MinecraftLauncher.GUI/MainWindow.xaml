<Window x:Class="Vantuz.Products.MinecraftLauncher.GUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Vantuz Minecraft Launcher"
        Height="600" Width="900"
        MinHeight="500" MinWidth="700"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#FF2D2D2D" Padding="20,15">
            <StackPanel>
                <TextBlock Text="VANTUZ"
                          FontSize="32" FontWeight="Black" Foreground="White" HorizontalAlignment="Center"/>
                <TextBlock Text="M I N E C R A F T  L A U N C H E R"
                          FontSize="11" Foreground="#FFAAAAAA" Margin="0,5,0,0" HorizontalAlignment="Center" FontWeight="SemiBold"/>
            </StackPanel>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1" Background="#FF1E1E1E">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel: Login & Settings -->
            <Border Grid.Column="0" Background="#FF252525" BorderBrush="#FF3D3D3D" BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20">

                        <!-- Login Section -->
                        <TextBlock Text="ВХОД" FontWeight="Bold" Foreground="White" Margin="0,0,0,15" FontSize="12"/>

                        <TextBlock Text="ЛОГИН" Foreground="#FFAAAAAA" FontSize="10" Margin="0,0,0,5"/>
                        <Border Background="#FF333333" CornerRadius="4" Margin="0,0,0,12">
                            <TextBox x:Name="UsernameBox"
                                    Background="Transparent"
                                    Foreground="White"
                                    BorderThickness="0"
                                    Padding="10,8"
                                    FontSize="13"
                                    CaretBrush="White"/>
                        </Border>

                        <TextBlock Text="ПАРОЛЬ" Foreground="#FFAAAAAA" FontSize="10" Margin="0,0,0,5"/>
                        <Border Background="#FF333333" CornerRadius="4" Margin="0,0,0,10">
                            <PasswordBox x:Name="PasswordBox"
                                        Background="Transparent"
                                        Foreground="White"
                                        BorderThickness="0"
                                        Padding="10,8"
                                        FontSize="13"
                                        CaretBrush="White"/>
                        </Border>

                        <CheckBox x:Name="RememberMeBox" Content="Запомнить меня"
                                 Foreground="#FFAAAAAA" Margin="0,0,0,25" FontSize="11"
                                 Cursor="Hand"/>

                        <!-- Settings Section -->
                        <TextBlock Text="НАСТРОЙКИ" FontWeight="Bold" Foreground="White" Margin="0,0,0,15" FontSize="12"/>

                        <TextBlock Text="ВЫДЕЛЕНИЕ ОЗУ" Foreground="#FFAAAAAA" FontSize="10" Margin="0,0,0,8"/>
                        <Slider x:Name="RamSlider"
                               Minimum="1024" Maximum="16384"
                               SmallChange="512" LargeChange="1024"
                               Value="4096"
                               TickFrequency="512"
                               IsSnapToTickEnabled="True"
                               Margin="0,0,0,5"/>
                        <TextBlock x:Name="RamText"
                                  Text="Выделено: 4096 МБ"
                                  Foreground="White"
                                  FontSize="11"
                                  Margin="0,0,0,20"
                                  FontWeight="SemiBold"/>

                        <!-- Play Button -->
                        <Button x:Name="PlayButton"
                               Content="ИГРАТЬ"
                               Height="45"
                               Background="#FF4CAF50"
                               Foreground="White"
                               FontWeight="Bold"
                               FontSize="14"
                               BorderThickness="0"
                               Cursor="Hand"
                               Click="PlayButton_Click"/>

                        <!-- Cancel Button -->
                        <Button x:Name="CancelButton"
                               Content="Отмена"
                               Height="35"
                               Background="Transparent"
                               Foreground="#FFAAAAAA"
                               FontSize="12"
                               BorderThickness="1"
                               BorderBrush="#FF555555"
                               Cursor="Hand"
                               Margin="0,10,0,0"
                               Click="CancelButton_Click"
                               Visibility="Collapsed"/>

                        <!-- Progress Section (initially collapsed) -->
                        <StackPanel x:Name="ProgressPanel" Visibility="Collapsed" Margin="0,20,0,0">
                            <TextBlock Text="СТАТУС" FontWeight="Bold" Foreground="White" Margin="0,0,0,10" FontSize="12"/>

                            <Border Background="#FF333333" CornerRadius="4" Padding="10" Margin="0,0,0,10">
                                <TextBlock x:Name="StatusText"
                                          Text="Подготовка..."
                                          TextWrapping="Wrap"
                                          Foreground="#FFDDDDDD"
                                          FontSize="11"/>
                            </Border>

                            <ProgressBar x:Name="MainProgressBar"
                                        Height="8"
                                        Background="#FF333333"
                                        Foreground="#FF4CAF50"
                                        BorderThickness="0"
                                        Maximum="100"/>

                            <TextBlock x:Name="ProgressPercentText"
                                      Text="0%"
                                      Foreground="#FFAAAAAA"
                                      HorizontalAlignment="Center"
                                      Margin="0,5,0,0"
                                      FontSize="11"/>

                            <!-- Operation-specific progress bars -->
                            <StackPanel x:Name="OperationsPanel" Margin="0,15,0,0"/>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Right Panel: Log Output -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#FF2D2D2D" Padding="15,10">
                    <TextBlock Text="Activity Log" FontWeight="Bold" Foreground="White"/>
                </Border>

                <Border Grid.Row="1" Background="#FF1E1E1E">
                    <ScrollViewer x:Name="LogScrollViewer" VerticalScrollBarVisibility="Auto">
                        <TextBox x:Name="LogTextBox"
                                Background="Transparent"
                                Foreground="#FFCCCCCC"
                                FontFamily="Consolas"
                                FontSize="12"
                                BorderThickness="0"
                                IsReadOnly="True"
                                TextWrapping="Wrap"
                                Padding="15"
                                AcceptsReturn="True"/>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2" Background="#FF2D2D2D" Padding="15,10">
            <Grid>
                <TextBlock x:Name="VersionText" Text="v1.0.0" Foreground="#FF666666" FontSize="10" VerticalAlignment="Center"/>
                <TextBlock Text="Compositum Architecture" Foreground="#FF666666" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
