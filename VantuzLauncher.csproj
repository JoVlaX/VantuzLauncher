<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <SelfContained>false</SelfContained>
    <!-- Workaround: SDK duplicates TargetFrameworkAttribute for WPF net8.0-windows (CS0579) -->
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Vantuz.Core\**" />
    <Compile Remove="Vantuz.Host\**" />
    <Compile Remove="Vantuz.Plugins.Auth\**" />
    <Compile Remove="Vantuz.Plugins.Net\**" />
    <Compile Remove="Vantuz.Plugins.OS\**" />
    <Compile Remove="Vantuz.Plugins.Game\**" />
    <Compile Remove="Vantuz.Plugins.Minecraft\**" />
    <Compile Remove="Vantuz.Builder\**" />
    <Compile Remove="Armatura.Core.Sdk\**" />
    <!-- DEVIATION-001: GUI plugin in Products folder - Compile Remove per INVARIANT_THEORY.md Category Isolation -->
    <Compile Remove="Vantuz.Products\**" />
    <Compile Remove="Vantuz.Plugins.Test\**" />
    <EmbeddedResource Remove="Vantuz.Core\**" />
    <EmbeddedResource Remove="Vantuz.Host\**" />
    <EmbeddedResource Remove="Vantuz.Plugins.Auth\**" />
    <EmbeddedResource Remove="Vantuz.Plugins.Net\**" />
    <EmbeddedResource Remove="Vantuz.Plugins.OS\**" />
    <EmbeddedResource Remove="Vantuz.Plugins.Game\**" />
    <EmbeddedResource Remove="Vantuz.Plugins.Minecraft\**" />
    <EmbeddedResource Remove="Vantuz.Builder\**" />
    <EmbeddedResource Remove="Vantuz.Products\**" />
    <None Remove="Vantuz.Core\**" />
    <None Remove="Vantuz.Host\**" />
    <None Remove="Vantuz.Plugins.Auth\**" />
    <None Remove="Vantuz.Plugins.Net\**" />
    <None Remove="Vantuz.Plugins.OS\**" />
    <None Remove="Vantuz.Plugins.Game\**" />
    <None Remove="Vantuz.Plugins.Minecraft\**" />
    <None Remove="Vantuz.Builder\**" />
    <None Remove="Vantuz.Products\**" />
    <Page Remove="Vantuz.Core\**" />
    <Page Remove="Vantuz.Host\**" />
    <Page Remove="Vantuz.Plugins.Auth\**" />
    <Page Remove="Vantuz.Plugins.Net\**" />
    <Page Remove="Vantuz.Plugins.OS\**" />
    <Page Remove="Vantuz.Plugins.Game\**" />
    <Page Remove="Vantuz.Plugins.Minecraft\**" />
    <Page Remove="Vantuz.Builder\**" />
    <Page Remove="Vantuz.Products\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="Vantuz.Core\Vantuz.Core.csproj" />
    <ProjectReference Include="Vantuz.Host\Vantuz.Host.csproj" />
    <!-- DEVIATION-001: Build order only - GUI plugin in Products folder per Component Scope violation -->
    <ProjectReference Include="Vantuz.Products\Vantuz.Products.MinecraftLauncher.GUI\Vantuz.Products.MinecraftLauncher.GUI.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <Private>false</Private>
    </ProjectReference>
    <!-- Headless test plugin per INVARIANT_THEORY.md Measurability -->
    <ProjectReference Include="Vantuz.Plugins.Test\Vantuz.Plugins.Test.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <Private>false</Private>
    </ProjectReference>
    <ProjectReference Include="Vantuz.Plugins.Auth\Vantuz.Plugins.Auth.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <Private>false</Private>
    </ProjectReference>
    <ProjectReference Include="Vantuz.Plugins.Net\Vantuz.Plugins.Net.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <Private>false</Private>
    </ProjectReference>
    <ProjectReference Include="Vantuz.Plugins.OS\Vantuz.Plugins.OS.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <Private>false</Private>
    </ProjectReference>
    <ProjectReference Include="Vantuz.Plugins.Game\Vantuz.Plugins.Game.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <Private>false</Private>
    </ProjectReference>
    <ProjectReference Include="Vantuz.Plugins.Minecraft\Vantuz.Plugins.Minecraft.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Text.Encoding.CodePages" Version="8.0.0" />
    <PackageReference Include="Obfuscar" Version="2.2.38">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Obfuscar temporarily disabled for refactoring
  <Target AfterTargets="AfterBuild" Name="Obfuscate" Condition="'$(Configuration)' == 'Release'">
    <PropertyGroup>
      <ObfuscarConfig>$(ProjectDir)obfuscar.xml</ObfuscarConfig>
    </PropertyGroup>
    <Exec Command="$(Obfuscar) $(ObfuscarConfig)" WorkingDirectory="$(TargetDir)" />
    <Copy SourceFiles="$(TargetDir)Obfuscated\VantuzLauncher.dll" DestinationFolder="$(TargetDir)" OverwriteReadOnlyFiles="true" />
  </Target>
  -->

 
  <!-- Armatura Full Automation: Pre-Build Verification -->
  <!-- Per INVARIANT_THEORY.md В§1.2 Measurability: All states must be verifiable at build time -->
  <Target Name="ArmaturaPreBuildVerification" BeforeTargets="BeforeBuild">
    <Message Text="[Armatura] Starting pre-build verification..." Importance="high" />
    
    <!-- ARM-BUILD-001: Critical configuration files must exist -->
    <Error Condition="!Exists('$(ProjectDir)boot.gui.json')" 
           Text="ARM-BUILD-001: Critical file 'boot.gui.json' not found. GUI mode will be unavailable. Per INVARIANT_THEORY.md В§2.1 (Explicitness)." />
    
    <Error Condition="!Exists('$(ProjectDir)boot.test.json')" 
           Text="ARM-BUILD-002: Critical file 'boot.test.json' not found. Test mode will be unavailable. Per INVARIANT_THEORY.md В§2.1 (Explicitness)." />
    
    <Error Condition="!Exists('$(ProjectDir)boot.headless.json')" 
           Text="ARM-BUILD-002B: Critical file 'boot.headless.json' not found. Headless test mode will be unavailable. Per INVARIANT_THEORY.md В§1.2 (Measurability)." />
    
    <Error Condition="!Exists('$(ProjectDir)boot.template.json')" 
           Text="ARM-BUILD-003: Critical file 'boot.template.json' not found. Manifest generation will fail. Per INVARIANT_THEORY.md В§2.1 (Explicitness)." />
    
    <!-- ARM-BUILD-004: Deviation protocols must be documented -->
    <Warning Condition="!Exists('$(ProjectDir)docs/deviations/DEVIATION-001.md')" 
             Text="ARM-BUILD-004-WARN: DEVIATION-001 protocol not found. Active violations may be undocumented." />
    
    <Warning Condition="!Exists('$(ProjectDir)docs/deviations/DEVIATION-002.md')" 
             Text="ARM-BUILD-005-WARN: DEVIATION-002 protocol not found. Build-time verification status unknown." />
    
    <!-- ARM-BUILD-006: Verification checklist must exist -->
    <Error Condition="!Exists('$(ProjectDir)docs/verification-checklist.md')" 
           Text="ARM-BUILD-006: Verification checklist not found. Pre-commit protocol undefined. Per INVARIANT_THEORY.md В§3.4 (Falsifiability)." />
    
    <Message Text="[Armatura] Pre-build verification passed. Proceeding with build." Importance="high" />
  </Target>

  <!-- DEVIATION-002: Pre-build verification per INVARIANT_THEORY.md В§1.2 Measurability -->
  <!-- Release-only: dotnet run (Debug) does not guarantee GUI plugin output exists -->
  <Target Name="VerifyGUIPluginSourceExists" BeforeTargets="AssembleVantuz" Condition="'$(Configuration)' == 'Release'">
    <PropertyGroup>
      <GUIPluginSource>$(ProjectDir)Vantuz.Products\Vantuz.Products.MinecraftLauncher.GUI\bin\$(Configuration)\net8.0-windows\Vantuz.Products.MinecraftLauncher.GUI.dll</GUIPluginSource>
    </PropertyGroup>

    <Error Condition="!Exists('$(GUIPluginSource)')"
           Text="DEVIATION-002 ACTIVE: GUI Plugin DLL not found at '$(GUIPluginSource)'. Build Vantuz.Products.MinecraftLauncher.GUI project first. See docs/deviations/DEVIATION-002.md" />

    <Message Text="[Vantuz Assembler] DEVIATION-002: GUI Plugin source verified." Importance="high" />
  </Target>

  <Target Name="AssembleVantuz" AfterTargets="Build">
    <Message Text="[Vantuz Assembler] Copying plugins to target directory..." Importance="high" />
    <ItemGroup>
      <PluginNetFiles Include="$(ProjectDir)Vantuz.Plugins.Net\bin\$(Configuration)\net8.0\**\*.*" />
      <PluginAuthFiles Include="$(ProjectDir)Vantuz.Plugins.Auth\bin\$(Configuration)\net8.0\**\*.*" />
      <PluginOSFiles Include="$(ProjectDir)Vantuz.Plugins.OS\bin\$(Configuration)\net8.0\**\*.*" />
      <PluginGameFiles Include="$(ProjectDir)Vantuz.Plugins.Game\bin\$(Configuration)\net8.0\**\*.*" />
      <PluginMinecraftFiles Include="$(ProjectDir)Vantuz.Plugins.Minecraft\bin\$(Configuration)\net8.0\**\*.*" />
      <!-- DEVIATION-001: Products folder for GUI plugin pending migration to Vantuz.Plugins.GUI -->
      <!-- Note: WPF projects use net8.0-windows target framework -->
      <PluginGUIFiles Include="$(ProjectDir)Vantuz.Products\Vantuz.Products.MinecraftLauncher.GUI\bin\$(Configuration)\net8.0-windows\**\*.*" />
      <!-- Headless test plugin per INVARIANT_THEORY.md Measurability -->
      <PluginTestFiles Include="$(ProjectDir)Vantuz.Plugins.Test\bin\$(Configuration)\net8.0\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(PluginNetFiles)" DestinationFolder="$(TargetDir)plugins\%(RecursiveDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(PluginAuthFiles)" DestinationFolder="$(TargetDir)plugins\%(RecursiveDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(PluginOSFiles)" DestinationFolder="$(TargetDir)plugins\%(RecursiveDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(PluginGameFiles)" DestinationFolder="$(TargetDir)plugins\%(RecursiveDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(PluginMinecraftFiles)" DestinationFolder="$(TargetDir)plugins\%(RecursiveDir)" SkipUnchangedFiles="true" />
    <!-- DEVIATION-001: Copy GUI plugin from Products pending migration to Vantuz.Plugins.GUI -->
    <Copy SourceFiles="@(PluginGUIFiles)" DestinationFolder="$(TargetDir)plugins\%(RecursiveDir)" SkipUnchangedFiles="true" />
    <!-- Copy headless test plugin per INVARIANT_THEORY.md Measurability -->
    <Copy SourceFiles="@(PluginTestFiles)" DestinationFolder="$(TargetDir)plugins\%(RecursiveDir)" SkipUnchangedFiles="true" />

    <!-- Copy GUI manifest per INVARIANT_THEORY.md Explicitness - GUI mode configuration -->
    <Copy SourceFiles="$(ProjectDir)boot.gui.json" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
    <Message Text="[Vantuz Assembler] GUI manifest copied: boot.gui.json" Importance="high" />

    <!-- Copy test manifest per INVARIANT_THEORY.md Explicitness - separate test configuration -->
    <Copy SourceFiles="$(ProjectDir)boot.test.json" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
    <Message Text="[Vantuz Assembler] Test manifest copied: boot.test.json" Importance="high" />

    <!-- Copy headless manifest per INVARIANT_THEORY.md Measurability - headless automated testing -->
    <Copy SourceFiles="$(ProjectDir)boot.headless.json" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
    <Message Text="[Vantuz Assembler] Headless manifest copied: boot.headless.json" Importance="high" />

    <!-- Copy .dev marker only for Debug builds per INVARIANT_THEORY.md В§498 - explicit dev mode detection -->
    <Copy SourceFiles="$(ProjectDir).dev" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" Condition="'$(Configuration)' == 'Debug'" />
    <Message Text="[Vantuz Assembler] Dev marker copied: .dev (Debug only)" Importance="high" Condition="'$(Configuration)' == 'Debug'" />

    <Message Text="[Vantuz Assembler] Running Manifest Builder for Hash Pinning..." Importance="high" />
    <Exec Command="dotnet run --project &quot;$(ProjectDir)Vantuz.Builder\Vantuz.Builder.csproj&quot; -- &quot;$(ProjectDir)boot.template.json&quot; &quot;$(TargetDir)plugins&quot; &quot;$(TargetDir)boot.json&quot;" />
  </Target>

  <!-- DEVIATION-002: Post-build verification per INVARIANT_THEORY.md В§1.2 Measurability -->
  <!-- Release-only: Debug builds skip GUI plugin check to support dotnet run -->
  <Target Name="VerifyGUIPluginCopied" AfterTargets="AssembleVantuz" Condition="'$(Configuration)' == 'Release'">
    <Error Condition="!Exists('$(TargetDir)plugins\Vantuz.Products.MinecraftLauncher.GUI.dll')"
           Text="DEVIATION-002 ACTIVE: GUI Plugin DLL not copied to plugins directory. Check AssembleVantuz target. See docs/deviations/DEVIATION-002.md" />

    <Message Text="[Vantuz Assembler] DEVIATION-002: GUI Plugin copy verified in output/plugins." Importance="high" />
  </Target>

  <!-- Armatura Full Automation: Post-Build Verification -->
  <!-- Per INVARIANT_THEORY.md В§1.2: Output integrity must be measurable -->
  <Target Name="ArmaturaPostBuildVerification" AfterTargets="VerifyGUIPluginCopied">
    <Message Text="[Armatura] Starting post-build verification..." Importance="high" />
    
    <!-- ARM-BUILD-007: Output manifests must exist -->
    <Error Condition="!Exists('$(TargetDir)boot.json')" 
           Text="ARM-BUILD-007: Generated 'boot.json' not found. Manifest generation failed." />
    
    <Error Condition="!Exists('$(TargetDir)boot.gui.json')" 
           Text="ARM-BUILD-008: 'boot.gui.json' not copied to output. GUI mode will fail." />
    
    <Error Condition="!Exists('$(TargetDir)boot.test.json')" 
           Text="ARM-BUILD-009: 'boot.test.json' not copied to output. Test mode will fail." />
    
    <Error Condition="!Exists('$(TargetDir)boot.headless.json')" 
           Text="ARM-BUILD-009B: 'boot.headless.json' not copied to output. Headless test mode will fail." />
    
    <!-- ARM-BUILD-010: Required plugins must be present -->
    <Error Condition="!Exists('$(TargetDir)plugins\Vantuz.Plugins.Auth.dll')" 
           Text="ARM-BUILD-010: Auth plugin not found in output/plugins." />
    
    <Error Condition="!Exists('$(TargetDir)plugins\Vantuz.Plugins.Net.dll')" 
           Text="ARM-BUILD-011: Net plugin not found in output/plugins." />
    
    <Error Condition="!Exists('$(TargetDir)plugins\Vantuz.Plugins.OS.dll')" 
           Text="ARM-BUILD-012: OS plugin not found in output/plugins." />
    
    <Error Condition="!Exists('$(TargetDir)plugins\Vantuz.Plugins.Game.dll')" 
           Text="ARM-BUILD-013: Game plugin not found in output/plugins." />
    
    <Error Condition="!Exists('$(TargetDir)plugins\Vantuz.Plugins.Minecraft.dll')" 
           Text="ARM-BUILD-014: Minecraft plugin not found in output/plugins." />
    
    <!-- ARM-BUILD-015: GUI plugin (DEVIATION-001) must be present (Release only) -->
    <Error Condition="'$(Configuration)' == 'Release' And !Exists('$(TargetDir)plugins\Vantuz.Products.MinecraftLauncher.GUI.dll')" 
           Text="ARM-BUILD-015: GUI plugin not found in output/plugins. DEVIATION-001 may not be correctly handled." />
    
    <!-- ARM-BUILD-016: Dev marker copied (Debug only) -->
    <Message Condition="'$(Configuration)' == 'Debug' And Exists('$(TargetDir).dev')" 
             Text="[Armatura] Dev marker confirmed in output (Debug mode)." Importance="high" />
    
    <Message Text="[Armatura] Post-build verification passed. Build complete." Importance="high" />
  </Target>

</Project>
