{
  "_comment": "Production boot for Minecraft Launcher with GUI per INVARIANT_THEORY.md §2.2 CQRS, §498 Explicit UI",
  "product": "MinecraftLauncher",
  "variables": {
    "localVersion": "2.0-dev",
    "gameProvider": "Minecraft",
    "gameVersion": "1.20.1-forge-47.3.0",
    "mcDir": "${special:ApplicationData}\\.vantuzlauncher",
    "installDir": "{{mcDir}}\\.minecraft",
    "operationTimeout": "00:05:00",
    "authEndpoint": "https://troglobit.webhm.pro/yggdrasil",
    "authUrl": "{{authEndpoint}}/authserver/authenticate",
    "launcherVersion": "2.0-dev"
  },
  "plugins": {
    "Vantuz.Products.MinecraftLauncher.GUI.dll": "",
    "Vantuz.Plugins.Auth.dll": "",
    "Vantuz.Plugins.Net.dll": "",
    "Vantuz.Plugins.OS.dll": "",
    "Vantuz.Plugins.Game.dll": "",
    "Vantuz.Plugins.Minecraft.dll": ""
  },
  "pipeline": [
    {
      "_comment": "Phase 1: GUI Initialization - Per COMPOSITUM_SPECIFICATION.md §4.1, GUI must be first to register capabilities",
      "pluginName": "GUI.MinecraftLauncher",
      "config": {
        "theme": "dark",
        "showProgress": true,
        "autoCloseOnLaunch": false
      }
    },
    {
      "_comment": "Phase 2: Credential Collection - Per INVARIANT_THEORY.md §2.2, UI Command before auth Query",
      "pluginName": "GUI.CredentialCollection",
      "config": {
        "_description": "Collect username/password from user via registered ICredentialProvider"
      }
    },
    {
      "_comment": "Phase 3: Authentication - Executes after credentials collected",
      "pluginName": "Auth.YggdrasilCommand",
      "config": {
        "url": "{{authUrl}}",
        "ignoreSslErrors": true,
        "launcherVersion": "{{launcherVersion}}"
      }
    },
    {
      "_comment": "Phase 4: Game installation",
      "pluginName": "Game.InstallerCommand",
      "config": {
        "provider": "{{gameProvider}}",
        "version": "{{gameVersion}}",
        "installDir": "{{installDir}}"
      }
    },
    {
      "_comment": "Phase 5: Version validation",
      "pluginName": "Game.VersionValidatorQuery",
      "config": {
        "provider": "{{gameProvider}}",
        "version": "{{gameVersion}}",
        "installDir": "{{installDir}}"
      }
    },
    {
      "_comment": "Phase 6: Launch preparation",
      "pluginName": "Game.LaunchCommand",
      "config": {
        "provider": "{{gameProvider}}",
        "version": "{{gameVersion}}",
        "installDir": "{{installDir}}",
        "authlibPath": "{{mcDir}}\\authlib-injector.jar",
        "authlibUrl": "{{authEndpoint}}/"
      }
    }
  ]
}
