{
  "_comment": "Production boot for Minecraft Launcher with GUI per INVARIANT_THEORY.md §498",
  "product": "MinecraftLauncher",
  "variables": {
    "localVersion": "2.0-dev",
    "gameProvider": "Minecraft",
    "gameVersion": "1.20.1-forge-47.3.0",
    "mcDir": "${special:ApplicationData}\\.vantuzlauncher",
    "installDir": "{{mcDir}}\\.minecraft",
    "operationTimeout": "00:05:00"
  },
  "plugins": {
    "Vantuz.Plugins.GUI.MinecraftLauncher.dll": "",
    "Vantuz.Plugins.Auth.dll": "",
    "Vantuz.Plugins.Net.dll": "",
    "Vantuz.Plugins.OS.dll": "",
    "Vantuz.Plugins.Game.dll": "",
    "Vantuz.Plugins.Minecraft.dll": ""
  },
  "pipeline": [
    {
      "_comment": "Phase 1: Initialize GUI and collect credentials",
      "pluginName": "GUI.MinecraftLauncher",
      "config": {
        "theme": "dark",
        "showProgress": true,
        "autoCloseOnLaunch": false
      }
    },
    {
      "_comment": "Phase 2: Credential collection via GUI",
      "pluginName": "GUI.CredentialCollection",
      "config": {}
    },
    {
      "_comment": "Phase 3: User authentication (production)",
      "pluginName": "Auth.YggdrasilCommand",
      "config": {
        "url": "https://authserver.mojang.com",
        "ignoreSslErrors": false
      }
    },
    {
      "_comment": "Phase 4: Register Minecraft game provider",
      "pluginName": "Game.MinecraftProvider",
      "config": {}
    },
    {
      "_comment": "Phase 5: Game installation",
      "pluginName": "Game.InstallerCommand",
      "config": {
        "provider": "{{gameProvider}}",
        "version": "{{gameVersion}}",
        "installDir": "{{installDir}}"
      }
    },
    {
      "_comment": "Phase 6: Version validation",
      "pluginName": "Game.VersionValidatorQuery",
      "config": {
        "provider": "{{gameProvider}}",
        "version": "{{gameVersion}}",
        "installDir": "{{installDir}}"
      }
    },
    {
      "_comment": "Phase 7: Download authlib-injector before launch",
      "pluginName": "Net.DownloadCommand",
      "config": {
        "files": [
          {
            "relativePath": "authlib-injector.jar",
            "url": "https://github.com/yushijinhun/authlib-injector/releases/download/v1.2.7/authlib-injector-1.2.7.jar",
            "hash": "",
            "size": 0
          }
        ]
      }
    },
    {
      "_comment": "Phase 8: Launch preparation",
      "pluginName": "Game.LaunchCommand",
      "config": {
        "provider": "{{gameProvider}}",
        "version": "{{gameVersion}}",
        "installDir": "{{installDir}}",
        "authlibPath": "{{mcDir}}\\authlib-injector.jar",
        "authlibUrl": "https://yggdrasil.example.com/"
      }
    },
    {
      "_comment": "Phase 8: Execute the game process",
      "pluginName": "OS.ExecuteCommand",
      "config": {
        "fileName": "{{gameCommand}}",
        "arguments": "{{gameArgs}}",
        "workDir": "{{gameWorkDir}}",
        "waitForExit": false
      }
    }
  ]
}
