{
  "_description": "Test manifest per INVARIANT_THEORY.md - explicit test configuration",
  "_principles": ["SRP", "Explicitness", "Determinism", "Nomadic", "Measurability"],
  "variables": {
    "localVersion": "2.0-dev",
    "gameProvider": "Minecraft",
    "gameVersion": "1.20.1-forge-47.2.20",
    "mcDir": "${special:ApplicationData}\\.vantuzlauncher",
    "installDir": "{{mcDir}}\\.minecraft",
    "operationTimeout": "00:01:00",
    "_justification_timeout": "Test mode uses shorter timeout per INVARIANT_THEORY.md §1.2 - faster feedback"
  },
  "plugins": {
    "Vantuz.Plugins.Auth.dll": "",
    "Vantuz.Plugins.Net.dll": "",
    "Vantuz.Plugins.OS.dll": "",
    "Vantuz.Plugins.Game.dll": "",
    "Vantuz.Plugins.Minecraft.dll": ""
  },
  "pipeline": [
    {
      "_comment": "Phase 2: Deterministic test auth per Axiom of Determinism (17)",
      "pluginName": "Auth.TestAuthCommand",
      "config": {}
    },
    {
      "_comment": "Game provider - provides Minecraft-specific data",
      "pluginName": "Game.MinecraftProvider",
      "config": {}
    },
    {
      "_comment": "Phase 3: Version validation per Measurability (31)",
      "pluginName": "Game.VersionValidatorQuery",
      "config": {
        "provider": "{{gameProvider}}",
        "version": "{{gameVersion}}",
        "installDir": "{{installDir}}",
        "_testMode": true
      }
    },
    {
      "_comment": "Phase 3: Mock installer - creates minimal test environment",
      "pluginName": "Game.InstallerCommand",
      "config": {
        "provider": "{{gameProvider}}",
        "version": "{{gameVersion}}",
        "installDir": "{{installDir}}",
        "_testMode": true
      }
    },
    {
      "_comment": "Phase 3A: Delta analysis with mock target state per Measurability (31)",
      "pluginName": "OS.DeltaAnalyzerQuery",
      "config": {
        "_testMode": true,
        "_mockTargetState": []
      }
    },
    {
      "_comment": "Phase 3B: Local move optimization per CQRS (72-79)",
      "pluginName": "OS.LocalMoveCommand",
      "config": {
        "_testMode": true
      }
    },
    {
      "_comment": "Phase 3C: Download command mock per Nomadic Invariant (152-164)",
      "pluginName": "Net.DownloadCommand",
      "config": {
        "_testMode": true,
        "_skipActualDownload": true
      }
    },
    {
      "_comment": "Phase 3D: Batch purge with dry-run per Resource Classification (208-240)",
      "pluginName": "OS.BatchPurgeCommand",
      "config": {
        "_testMode": true,
        "_dryRun": true
      }
    },
    {
      "_comment": "Phase 3E: Launch preparation per SRP (48-52)",
      "pluginName": "Game.LaunchCommand",
      "config": {
        "provider": "{{gameProvider}}",
        "version": "{{gameVersion}}",
        "installDir": "{{installDir}}",
        "authlibPath": "{{mcDir}}\\authlib-injector.jar",
        "authlibUrl": "test://yggdrasil/",
        "_testMode": true
      }
    },
    {
      "_comment": "Phase 4: Process execution with verification per Determinism (17)",
      "pluginName": "OS.ExecuteCommand",
      "config": {
        "_testMode": true,
        "_recordJavaPid": true
      }
    }
  ]
}
